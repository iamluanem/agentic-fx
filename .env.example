# Copy to .env and adjust. docker compose reads it automatically. Never commit .env.

# Shared by fx-api (signs tokens) and agent-service (verifies them). At least 32 bytes.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-bytes

DB_PASSWORD=agenticfx

# Optional: enables Claude for intent parsing and the advisory agent. Without it, the deterministic
# fallbacks are used and everything still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
